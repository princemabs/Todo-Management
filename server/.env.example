PORT=3001
NODE_ENV=production
SESSION_SECRET=change-me-long-random-string

# URL Vercel (plusieurs origines séparées par des virgules si besoin)
CLIENT_ORIGIN=https://ton-app.vercel.app

# Obligatoire si front (Vercel) et back (Render) sont sur des domaines différents
CROSS_ORIGIN=true

EDITOR_USERNAME=princeofjesus
EDITOR_PASSWORD=change-me

# Render: UNIQUEMENT si un disque persistant est monté sur /var/data
# Sinon laisser commenté (données dans data/planner.json à la racine du repo)
# PLANNER_DATA_PATH=/var/data/planner.json
